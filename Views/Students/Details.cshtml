@model MiniProjectMVC.Models.Student
@{
    ViewBag.Title = "Student Details";
}

<h1>Student Details</h1>

<table>
    <tr><th>Name</th><td>@Model.Name</td></tr>
    <tr><th>Email</th><td>@Model.Email</td></tr>
    <tr><th>Course</th><td>@Model.Course</td></tr>
    <tr><th>Semester</th><td>@Model.Semester</td></tr>
    <tr><th>Enrollment Date</th><td>@Model.EnrollmentDate.ToString("dd MMM yyyy")</td></tr>
</table>

<div style="margin-top:20px;">
    <a class="btn btn-primary" href="@Url.Action("Edit", new { id = Model.Id })">Edit</a>
    <a class="btn btn-secondary" href="@Url.Action("Index")">Back to List</a>

    @using (Html.BeginForm("Delete", "Students", new { id = Model.Id }, FormMethod.Post, new { style = "display:inline" }))
    {
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger" onclick="return confirm('Delete this student?');">Delete</button>
    }
</div>
