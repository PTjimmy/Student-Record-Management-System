@model MiniProjectMVC.Models.Student
@{
    ViewBag.Title = "Add Student";
}

<h1>Add New Student</h1>

@using (Html.BeginForm("Create", "Students", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

    <label>Full Name</label>
    @Html.TextBoxFor(m => m.Name)
    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })

    <label>Email</label>
    @Html.TextBoxFor(m => m.Email)
    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })

    <label>Course</label>
    @Html.TextBoxFor(m => m.Course)
    @Html.ValidationMessageFor(m => m.Course, "", new { @class = "text-danger" })

    <label>Semester</label>
    @Html.TextBoxFor(m => m.Semester, new { type = "number", min = 1, max = 8 })
    @Html.ValidationMessageFor(m => m.Semester, "", new { @class = "text-danger" })

    <label>Enrollment Date</label>
    @Html.TextBoxFor(m => m.EnrollmentDate, "{0:yyyy-MM-dd}", new { type = "date" })
    @Html.ValidationMessageFor(m => m.EnrollmentDate, "", new { @class = "text-danger" })

    <div style="margin-top:18px;">
        <button type="submit" class="btn btn-primary">Save Student</button>
        <a class="btn btn-secondary" href="@Url.Action("Index")">Cancel</a>
    </div>
}
